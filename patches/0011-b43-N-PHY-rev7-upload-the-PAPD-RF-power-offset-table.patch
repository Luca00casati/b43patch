From a777843fb9ba0e78dae5799275cb89fda302a59f Mon Sep 17 00:00:00 2001
From: Luca Casati <luk00casati@gmail.com>
Date: Sat, 24 Oct 2026 23:16:57 +0200
Subject: [PATCH 11/14] b43: N-PHY rev7+: upload the PAPD RF power offset table

b43_nphy_tx_gain_table_upload() returned before writing the per TX
power index RF power offsets (tables 26/27 at 576) on rev7+ ("TODO:
Enable this once we have gains configured"). The brcmsmac formula
matches all 128 entries wl 6.30 writes on a BCM43228, so enable it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/broadcom/b43/phy_n.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index d91f7d563..c621c5923 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -4299,11 +4299,14 @@ static void b43_nphy_tx_gain_table_upload(struct b43_wldev *dev)
 	if (phy->rev >= 19) {
 		return;
 	} else if (phy->rev >= 7) {
+		/*
+		 * The PAPD RF power offset per TX power index; with hwpctl
+		 * the PHY picks the entry for the current index. Matches
+		 * wl 6.30 on radio 2057 rev 9 for all 128 entries.
+		 */
 		rf_pwr_offset_table = b43_ntab_get_rf_pwr_offset_table(dev);
 		if (!rf_pwr_offset_table)
 			return;
-		/* TODO: Enable this once we have gains configured */
-		return;
 	}
 
 	for (i = 0; i < 128; i++) {
-- 
